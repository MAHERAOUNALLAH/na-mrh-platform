// ============================================================
// NA-MRH Digital Platform — schema.prisma
// Version 2 — base de référence pour la construction du frontend
//
// 14 tables : countries, functions, twgs, twg_members, users,
// user_functions, documents, document_versions, document_comments,
// document_events, news, complaints.
//
// Changements par rapport à la version 1 (8 tables) :
//   [C1]  Twg.id passe en String (slug : 'ma-twg', 'gmp-twg') — sert de
//         paramètre de route côté frontend.
//   [C2]  Twg.functionCode : lien explicite entre un GTT et la fonction
//         réglementaire qu'il couvre.
//   [C3]  NOUVEAU TwgMember : lien utilisateur ↔ GTT avec rôle
//         (lead / colead / member). C'est le socle des autorisations :
//         « ce contributeur ne peut déposer que dans le GTT BPF ».
//   [C4]  Document : champs de fichier (fileName, filePath, mimeType,
//         sizeBytes) — sans eux la bibliothèque n'est qu'une liste de titres.
//   [C5]  NOUVEAU DocumentVersion : historique v1.0 → v1.1. Indispensable
//         pour répondre à « quelle version les ANR ont-elles revue ? ».
//   [C6]  NOUVEAU DocumentComment : commentaires du circuit de validation.
//   [C7]  NOUVEAU DocumentEvent : journal d'événements / traçabilité.
//   [C8]  Document.validatedByBody : la validation est faite par un organe
//         (Secrétariat, Comité de Pilotage), pas seulement par une personne.
//   [C9]  User.isActive : désactivation logique. Un utilisateur auteur d'un
//         document ne peut pas être supprimé (FK Restrict) — il est désactivé.
//   [C10] User.preferredLang : plateforme trilingue.
//   [C11] Country.address{Fr,En,Ar} + updatedAt.
//   [C12] News.date{Fr,En,Ar} : la date affichée diffère par langue
//         ("Sept. 2026" / "Sep 2026" / "سبتمبر 2026").
//   [C13] Complaint.email + response + respondedAt : permet de répondre au
//         plaignant et de lui donner un suivi.
//   [C14] UserLevel en anglais, cohérent avec le reste des enums.
//
// INVARIANT MÉTIER À RESPECTER CÔTÉ APPLICATIF (non exprimable en SQL) :
//   Un document est visible dans la bibliothèque publique
//   SI ET SEULEMENT SI status = published_public ET visibility = public.
//   Toute autre combinaison est réservée au portail authentifié.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 : l'URL de connexion se déclare dans prisma.config.ts, plus ici.
  // Prisma 6 ou antérieur : décommenter la ligne suivante.
  // url = env("DATABASE_URL")
}

// ---------- Enums transverses ----------

enum Lang {
  fr
  en
  ar
}

enum OrgRole {
  president
  vice_president
  member
  secretariat
  other
}

// ---------- A. Organisation régionale ----------

model Country {
  id           String   @id // 'tn', 'dz' — sert aussi de code court et de nom de drapeau
  nameFr       String
  nameEn       String
  nameAr       String
  nraNameFr    String?
  nraNameEn    String?
  nraNameAr    String?
  addressFr    String?
  addressEn    String?
  addressAr    String?
  email        String?
  phone        String?
  website      String?
  orgRole      OrgRole?
  orgRoleOther String? // renseigné uniquement si orgRole = other
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  twgsAsLead   Twg[]       @relation("TwgLead")
  twgsAsColead Twg[]       @relation("TwgColead")
  complaints   Complaint[]

  @@map("countries")
}

model Function {
  code    String @id // 'MA', 'GMP', 'IMS', 'QMS', 'PV', 'MD', 'MS', 'CT', 'IMP', 'LAB', 'LIC', 'ADV'
  labelFr String
  labelEn String
  labelAr String

  userFunctions UserFunction[]
  twgs          Twg[]

  @@map("functions")
}

model Twg {
  id     String  @id // slug : 'ma-twg', 'gmp-twg' — utilisé comme paramètre de route
  nameFr String
  nameEn String
  nameAr String
  descFr String?
  descEn String?
  descAr String?
  wave   Int // 1, 2 ou 3

  // Fonction réglementaire couverte par ce GTT
  functionCode String?
  function     Function? @relation(fields: [functionCode], references: [code], onDelete: SetNull)

  // Pays porteurs (institutionnel) — distinct des personnes nommées (TwgMember)
  leadCountryId   String?
  leadCountry     Country? @relation("TwgLead", fields: [leadCountryId], references: [id], onDelete: SetNull)
  coleadCountryId String?
  coleadCountry   Country? @relation("TwgColead", fields: [coleadCountryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TwgMember[]
  documents Document[]

  @@index([functionCode])
  @@index([leadCountryId])
  @@index([coleadCountryId])
  @@index([wave])
  @@map("twgs")
}

// ---------- B. Utilisateurs et rôles ----------

enum UserLevel {
  reader
  contributor
  validator
  country_admin
  secretariat_admin
}

enum TwgRole {
  lead
  colead
  member
}

model User {
  id           Int       @id @default(autoincrement())
  countryId    String? // NULL si Secrétariat régional
  country      Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  name         String
  email        String    @unique
  passwordHash String
  level        UserLevel
  orgRole      OrgRole? // rôle institutionnel régional, si la personne en porte un
  orgRoleOther String?
  preferredLang Lang     @default(fr)
  isActive     Boolean   @default(true) // désactivation logique — jamais de DELETE
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userFunctions      UserFunction[]
  twgMemberships     TwgMember[]
  documentsCreated   Document[]          @relation("DocumentCreatedBy")
  documentsValidated Document[]          @relation("DocumentValidatedBy")
  documentVersions   DocumentVersion[]
  documentComments   DocumentComment[]
  documentEvents     DocumentEvent[]
  complaintsHandled  Complaint[]         @relation("ComplaintHandledBy")

  @@index([countryId])
  @@index([level])
  @@index([isActive])
  @@map("users")
}

// Fonctions réglementaires exercées par un utilisateur (N-N)
model UserFunction {
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionCode String
  function     Function @relation(fields: [functionCode], references: [code], onDelete: Cascade)

  @@id([userId, functionCode])
  @@index([functionCode])
  @@map("user_functions")
}

// Appartenance d'une personne à un GTT, avec son rôle.
// Base du contrôle d'accès : un contributeur ne peut agir que sur les
// documents des GTT où il est membre.
model TwgMember {
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twgId    String
  twg      Twg      @relation(fields: [twgId], references: [id], onDelete: Cascade)
  role     TwgRole  @default(member)
  joinedAt DateTime @default(now())

  @@id([userId, twgId])
  @@index([twgId])
  @@index([role])
  @@map("twg_members")
}

// ---------- C. Circuit documentaire ----------

enum DocumentCategory {
  guideline
  sop
  report
  template
}

enum DocumentVisibility {
  public
  internal
  confidential
}

enum DocumentStatus {
  draft_twg
  received_secretariat
  revision_requested
  pending_steering
  distributed_internal
  published_public
  archived
}

// Organes de validation — ce ne sont pas des utilisateurs
enum ValidatingBody {
  secretariat
  steering_committee
}

model Document {
  id      Int    @id @default(autoincrement())
  twgId   String
  twg     Twg    @relation(fields: [twgId], references: [id], onDelete: Restrict)
  titleFr String
  titleEn String
  titleAr String

  category   DocumentCategory
  phase      Int // 1, 2 ou 3
  visibility DocumentVisibility @default(internal)
  status     DocumentStatus     @default(draft_twg)

  // Version courante ; l'historique complet est dans document_versions
  version String @default("1.0")

  // Fichier de la version courante
  fileName  String?
  filePath  String? // chemin de stockage (disque ou objet S3) — jamais exposé tel quel
  mimeType  String?
  sizeBytes Int?

  // Validation : par un organe, et éventuellement par une personne nommée
  validatedByBody ValidatingBody?
  validatedById   Int?
  validatedBy     User?           @relation("DocumentValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?

  createdById Int
  createdBy   User     @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions DocumentVersion[]
  comments DocumentComment[]
  events   DocumentEvent[]

  @@index([twgId])
  @@index([createdById])
  @@index([validatedById])
  @@index([status])
  @@index([visibility])
  @@index([category])
  @@index([status, visibility]) // requête de la bibliothèque publique
  @@map("documents")
}

// Historique des versions : chaque dépôt de fichier crée une ligne.
model DocumentVersion {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    String // '1.0', '1.1', '2.0'
  fileName   String?
  filePath   String?
  mimeType   String?
  sizeBytes  Int?
  note       String? // ce qui change dans cette version
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdById])
  @@map("document_versions")
}

model DocumentComment {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([authorId])
  @@map("document_comments")
}

enum DocumentEventType {
  created
  version_submitted
  forwarded_to_secretariat
  revision_requested
  validated
  distributed_internal
  published_public
  archived
  visibility_changed
  commented
}

// Journal d'événements : alimente la frise chronologique du circuit
// et sert de piste d'audit. Jamais modifié, jamais supprimé.
model DocumentEvent {
  id         Int               @id @default(autoincrement())
  documentId Int
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type       DocumentEventType

  // Auteur de l'action : soit un utilisateur, soit un organe
  actorId   Int?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorBody ValidatingBody?
  actorLabel String? // libellé figé au moment de l'action, pour l'audit

  fromStatus DocumentStatus?
  toStatus   DocumentStatus?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([documentId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@map("document_events")
}

// ---------- D. Public & transverse ----------

model News {
  id      Int    @id @default(autoincrement())
  // Date affichée, propre à chaque langue — pas une date SQL
  dateFr  String // "Sept. 2026"
  dateEn  String // "Sep 2026"
  dateAr  String // "سبتمبر 2026"
  // Date technique, pour le tri
  sortDate DateTime
  titleFr String
  titleEn String
  titleAr String
  bodyFr  String
  bodyEn  String
  bodyAr  String

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([sortDate])
  @@map("news")
}

enum ComplaintNature {
  service
  delay
  access
  other
}

enum ComplaintStatus {
  received
  in_progress
  resolved
}

model Complaint {
  id        Int             @id @default(autoincrement())
  name      String
  email     String? // pour pouvoir répondre au plaignant
  org       String?
  countryId String?
  country   Country?        @relation(fields: [countryId], references: [id], onDelete: SetNull)
  nature    ComplaintNature
  message   String
  status    ComplaintStatus @default(received)

  // Traitement
  response    String?
  respondedAt DateTime?
  handledById Int?
  handledBy   User?     @relation("ComplaintHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([handledById])
  @@index([status])
  @@map("complaints")
}
